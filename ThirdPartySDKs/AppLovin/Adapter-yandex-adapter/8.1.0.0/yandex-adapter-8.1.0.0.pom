<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0" xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance">
  <modelVersion>4.0.0</modelVersion>
  <groupId>com.applovin.mediation</groupId>
  <artifactId>yandex-adapter</artifactId>
  <version>8.1.0.0</version>
  <packaging>aar</packaging>
  <name>yandex-adapter</name>
  <description>Yandex adapter for AppLovin MAX mediation</description>
  <url>https://www.applovin.com/</url>
  <licenses>
    <license>
      <name>AppLovin Corporation Mediation Adapter EULA</name>
      <url>https://www.applovin.com/eula</url>
    </license>
  </licenses>
  <scm>
    <connection>scm:git:https://github.com/AppLovin/AppLovin-MAX-SDK-Android.git</connection>
    <developerConnection>scm:git:ssh://https://github.com/AppLovin/AppLovin-MAX-SDK-Android.git</developerConnection>
    <url>https://github.com/AppLovin/AppLovin-MAX-SDK-Android</url>
  </scm>
  <developers>
    <developer>
      <name>AppLovin</name>
      <url>https://www.applovin.com</url>
    </developer>
  </developers>
  <dependencies>
    <dependency>
      <groupId>com.yandex.android</groupId>
      <artifactId>mobileads</artifactId>
      <version>8.1.0</version>
      <scope>compile</scope>
    </dependency>
    <dependency>
      <groupId>io.appmetrica.analytics</groupId>
      <artifactId>analytics</artifactId>
      <version>6.2.1</version>
      <scope>compile</scope>
    </dependency>
  </dependencies>
</project>
